<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <PropertyGroup>
    <DragoAntSharedVersion>9.0.0</DragoAntSharedVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsNET8)'=='True'">
    <MicrosoftExtensionsVersion Condition="'$(MicrosoftExtensionsVersion)'==''">8.0.2</MicrosoftExtensionsVersion>
    <MicrosoftExtensionsHttpVersion Condition="'$(MicrosoftExtensionsHttpVersion)'==''">8.0.1</MicrosoftExtensionsHttpVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsNET9)'=='True'">
    <MicrosoftExtensionsVersion Condition="'$(MicrosoftExtensionsVersion)'==''">9.0.20</MicrosoftExtensionsVersion>
    <MicrosoftExtensionsHttpVersion Condition="'$(MicrosoftExtensionsHttpVersion)'==''">9.0.20</MicrosoftExtensionsHttpVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsNET10)'=='True'">
    <MicrosoftExtensionsVersion Condition="'$(MicrosoftExtensionsVersion)'==''">10.0.12</MicrosoftExtensionsVersion>
    <MicrosoftExtensionsHttpVersion Condition="'$(MicrosoftExtensionsHttpVersion)'==''">10.0.12</MicrosoftExtensionsHttpVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsNET11)'=='True'">
    <MicrosoftExtensionsVersion Condition="'$(MicrosoftExtensionsVersion)'==''">11.0.0</MicrosoftExtensionsVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsNET12)'=='True'">
    <MicrosoftExtensionsVersion Condition="'$(MicrosoftExtensionsVersion)'==''">12.0.0</MicrosoftExtensionsVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsNET13)'=='True'">
    <MicrosoftExtensionsVersion Condition="'$(MicrosoftExtensionsVersion)'==''">13.0.0</MicrosoftExtensionsVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsNET14)'=='True'">
    <MicrosoftExtensionsVersion Condition="'$(MicrosoftExtensionsVersion)'==''">14.0.0</MicrosoftExtensionsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="DragoAnt.Shared" Version="$(DragoAntSharedVersion)" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Verify.DiffPlex" Version="3.4.0" />
    <PackageVersion Include="Verify" Version="33.2.0" />
    <PackageVersion Include="Verify.XunitV3" Version="32.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(MicrosoftExtensionsHttpVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="JsonMasking" Version="2.0.0" />
  </ItemGroup>
</Project>