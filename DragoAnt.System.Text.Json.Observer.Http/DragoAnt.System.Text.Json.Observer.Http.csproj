  <ItemGroup>
    <ProjectReference Include="..\DragoAnt.System.Text.Json.Observer\DragoAnt.System.Text.Json.Observer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DragoAnt.System.Text.Json.Observer.Http.Tests" />
  </ItemGroup>
