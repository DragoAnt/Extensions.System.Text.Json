<Project>
  <PropertyGroup>

    <TargetFrameworkStrategy>TargetFrameworks</TargetFrameworkStrategy>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>

  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory).msbuild\shared\init.props" />

  <PropertyGroup>
    <Copyright>Copyright (c) 2025 DragoAnt</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/DragoAnt/Extensions.System.Text.Json</RepositoryUrl>
    <PackageProjectUrl>https://github.com/DragoAnt/Extensions.System.Text.Json</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/DragoAnt/Extensions.System.Text.Json/releases</PackageReleaseNotes>
  </PropertyGroup>

</Project>
