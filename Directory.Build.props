<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Copyright>Copyright (c) 2025 DragoAnt</Copyright>
    <!-- MSBuildKit 0.1.0 sets this default too late for the SDK; drop once the kit sets it in its props phase. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory).toolkit/msbuild/init.props" />
</Project>
