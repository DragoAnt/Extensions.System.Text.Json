<Project>

  <Import Project="$(MSBuildThisFileDirectory).toolkit/msbuild/init.targets" />

  <!-- Every project but the library itself gets the package's implicit `using DragoAnt.Observer`, as a consumer does. -->
  <Import Project="$(MSBuildThisFileDirectory)DragoAnt.System.Text.Json.Observer/buildTransitive/DragoAnt.System.Text.Json.Observer.props"
          Condition="'$(MSBuildProjectName)' != 'DragoAnt.System.Text.Json.Observer'" />

  <!-- DynamicallyAccessedMemberTypes.None collides with the statically imported JsonTokenType.None. -->
  <ItemGroup>
    <Using Remove="System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes" />
  </ItemGroup>

  <!-- A library that sets EnforcePublicApiDocs fails its build on a public member without an XML doc comment. -->
  <PropertyGroup Condition="'$(EnforcePublicApiDocs)'=='true'">
    <NoWarn>$([System.String]::Copy('$(NoWarn)').Replace('CS1591',''))</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

</Project>
