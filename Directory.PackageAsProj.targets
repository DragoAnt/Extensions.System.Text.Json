<Project>

  <PropertyGroup>
    <SrcRootDir Condition="'$(SrcRootDir)'==''">$(MSBuildThisFileDirectory)../../</SrcRootDir>
  </PropertyGroup>

  <PropertyGroup>
    <PackageAsProj_DragoAnt_Shared_Path Condition="'$(PackageAsProj_DragoAnt_Shared_Path)'==''">$(SrcRootDir)Shared/PackageAsProj.targets</PackageAsProj_DragoAnt_Shared_Path>
  </PropertyGroup>

  <Import Condition="Exists('$(PackageAsProj_DragoAnt_Shared_Path)')" Project="$(PackageAsProj_DragoAnt_Shared_Path)" />

  <!-- DragoAntObserverLocal=true builds DragoAnt.Observer.Core and DragoAnt.Observer.Conformance from a sibling checkout of DragoAnt/Observer
       (DragoAntObserverRoot, ../Observer by default) instead of the package. -->
  <PropertyGroup>
    <DragoAntObserverRoot Condition="'$(DragoAntObserverRoot)'==''">$(MSBuildThisFileDirectory)../Observer/</DragoAntObserverRoot>
    <DragoAntObserverRoot>$([MSBuild]::EnsureTrailingSlash('$(DragoAntObserverRoot)'))</DragoAntObserverRoot>
    <_DragoAntObserverCoreProject>$(DragoAntObserverRoot)DragoAnt.Observer.Core/DragoAnt.Observer.Core.csproj</_DragoAntObserverCoreProject>
    <_DragoAntObserverConformanceProject>$(DragoAntObserverRoot)DragoAnt.Observer.Conformance/DragoAnt.Observer.Conformance.csproj</_DragoAntObserverConformanceProject>
    <_DragoAntObserverAsProj>false</_DragoAntObserverAsProj>
    <_DragoAntObserverAsProj Condition="'$(DragoAntObserverLocal)'=='true'">true</_DragoAntObserverAsProj>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Update="DragoAnt.Observer.Core" ProjPath="$(_DragoAntObserverCoreProject)" AsProj="$(_DragoAntObserverAsProj)" />
    <PackageReference Update="DragoAnt.Observer.Conformance" ProjPath="$(_DragoAntObserverConformanceProject)" AsProj="$(_DragoAntObserverAsProj)" />
  </ItemGroup>

  <Target Name="DragoAntObserverLocal_Validation" BeforeTargets="CollectPackageReferences;ResolveProjectReferences"
          Condition="'$(_DragoAntObserverAsProj)'=='true'">
    <Error Code="DAOBS001" Condition="!Exists('$(_DragoAntObserverCoreProject)')" Text="DragoAntObserverLocal is true but '$(_DragoAntObserverCoreProject)' does not exist. Clone DragoAnt/Observer next to this repository or set DragoAntObserverRoot." />
    <Error Code="DAOBS001" Condition="!Exists('$(_DragoAntObserverConformanceProject)')" Text="DragoAntObserverLocal is true but '$(_DragoAntObserverConformanceProject)' does not exist. Use a DragoAnt/Observer checkout that has DragoAnt.Observer.Conformance, or set DragoAntObserverRoot." />
  </Target>

</Project>
